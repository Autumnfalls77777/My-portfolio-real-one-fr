{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "publication",
        "award",
        "leadership",
        "competition",
        "certification",
        "contribution"
      ]
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}
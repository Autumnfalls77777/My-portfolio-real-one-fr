# Portfolio Application Environment Variables Blueprint
# Copy this file to .env or set these environment variables in your hosting provider (Render, Railway, Vercel, Base44, etc.)

# ── Frontend (Vite) Variables ──
VITE_DISCORD_USER_ID=852933502038966292
VITE_API_BASE_URL=/api/v1

# ── Backend Configuration ──
NODE_ENV=production
PORT=4000
API_VERSION=v1
APP_VERSION=1.0.0

# ── Database Connection (SQLite / PostgreSQL / MySQL) ──
DATABASE_URL="file:../../database/portfolio.db"
DIRECT_URL="file:../../database/portfolio.db"

# ── CORS & Domain Configuration ──
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# ── Security & Authentication Keys ──
JWT_SECRET=your_32_character_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32_character_refresh_secret_key_here
ADMIN_JWT_SECRET=your_32_character_admin_secret_key_here
JWT_ISSUER=prabal-portfolio-api
JWT_AUDIENCE=prabal-portfolio-client
ADMIN_ACCESS_CODE=your_secure_admin_access_code
CSRF_SECRET=your_32_character_csrf_secret_key_here

# ── Email / SMTP Configuration (Gmail SMTP or Resend) ──
